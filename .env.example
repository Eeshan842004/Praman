# Praman — environment template.
# Copy to `.env` (gitignored) and fill in. NEVER commit real values.
#   cp .env.example .env

# ── Razorpay (TEST MODE ONLY — never live keys) ───────────────────────────────
# Dashboard → Settings → API Keys (ensure the Test/Live toggle reads TEST)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Dashboard → Settings → Webhooks → create webhook → set a secret.
# Test-mode webhooks are configured SEPARATELY from live.
# Subscribe to: payment.failed, payment.authorized, order.paid, subscription.pending
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ── Gemini (explanation rendering only — NEVER authorises a money action) ─────
# https://aistudio.google.com/  — free tier is fine for development
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-flash-lite-latest

# ── OPA sidecar ───────────────────────────────────────────────────────────────
OPA_URL=http://127.0.0.1:8181
OPA_TIMEOUT_SECONDS=0.5

# ── Storage ───────────────────────────────────────────────────────────────────
LEDGER_PATH=data/ledger.db

# ── Experiment ────────────────────────────────────────────────────────────────
# Changing EXPERIMENT_ID re-randomises every arm assignment. Treat as immutable
# once a batch has been run.
EXPERIMENT_ID=praman-v1
# 20%, not 10%: measured coverage on heavy-tailed payment outcomes.
HOLDOUT_PCT=20

# ── Runtime ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENV=dev
